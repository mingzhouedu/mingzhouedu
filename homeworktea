<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <title>数学作业系统 - 明舟教育</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        *{margin:0;padding:0;box-sizing:border-box;font-family:"Microsoft YaHei",sans-serif;}
        body{background:#e3f2fd;padding:20px;max-width:1000px;margin:0 auto;}
        .header{background:#0288d1;color:white;padding:20px;text-align:center;border-radius:12px;margin-bottom:20px;}
        .back{padding:10px 20px;background:#01579b;color:white;border:none;border-radius:30px;cursor:pointer;margin-bottom:15px;}
        .role-tab{display:flex;gap:10px;margin-bottom:20px;}
        .role{flex:1;padding:12px;text-align:center;background:white;border:2px solid #90caf9;border-radius:8px;cursor:pointer;}
        .role.active{background:#0288d1;color:white;}
        .func-grid{display:grid;grid-template-columns:1fr 1fr;gap:15px;margin-bottom:20px;}
        .func-card{padding:20px;background:white;border-radius:12px;border-left:6px solid #0288d1;cursor:pointer;}
        .func-card h3{margin-bottom:8px;color:#01579b;}
        .panel{display:none;}
        .panel.active{display:block;}
        input,textarea{width:100%;padding:12px;margin:8px 0;border:1px solid #ddd;border-radius:8px;}
        .btn{padding:12px;background:#0288d1;color:white;border:none;border-radius:8px;cursor:pointer;width:100%;}
    </style>
</head>
<body>
<button class="back" onclick="location.href='index.html'">← 返回主页</button>
<div class="header">
    <h1>📐 数学作业管理系统</h1>
</div>
<div class="role-tab">
    <div class="role active" onclick="switchRole(0)">学生端</div>
    <div class="role" onclick="switchRole(1)">教师端</div>
</div>
<div class="func-grid">
    <div class="func-card" onclick="switchFunc(0)"><h3>📖 查看作业</h3><p>查看老师布置的任务</p></div>
    <div class="func-card" onclick="switchFunc(1)"><h3>📝 提交作业</h3><p>上传作业答案</p></div>
    <div class="func-card" onclick="switchFunc(2)"><h3>✅ 作业状态</h3><p>查看批改结果</p></div>
    <div class="func-card" onclick="switchFunc(3)"><h3>🎥 视频讲解</h3><p>观看解题视频</p></div>
    <div class="func-card" onclick="switchFunc(4)"><h3>📊 作业统计</h3><p>查看完成情况</p></div>
</div>
<div class="panel active" id="f0">
    <p>老师布置的数学作业列表将显示在这里</p>
</div>
<div class="panel" id="f1">
    <input placeholder="学生姓名">
    <input placeholder="作业标题">
    <textarea rows="4" placeholder="填写答案"></textarea>
    <input type="file" accept="image/*">
    <button class="btn">提交作业</button>
</div>
<div class="panel" id="f2"><p>待批改/已批改作业状态</p></div>
<div class="panel" id="f3"><p>数学作业讲解视频区</p></div>
<div class="panel" id="f4"><p>班级作业完成统计</p></div>
<script>
function switchRole(i){document.querySelectorAll('.role').forEach(r=>r.classList.remove('active'));document.querySelectorAll('.role')[i].classList.add('active');}
function switchFunc(i){document.querySelectorAll('.panel').forEach(p=>p.classList.remove('active'));document.getElementById('f'+i).classList.add('active');}
</script>
</body>
</html>
