// ====================== 本地存储工具 ======================
// 获取系统数据
function getSystemData() {
    const localData = localStorage.getItem('mingzhou-edu-data');
    return localData ? JSON.parse(localData) : JSON.parse(JSON.stringify(initSystemData));
}

// 保存系统数据
function saveSystemData(data) {
    localStorage.setItem('mingzhou-edu-data', JSON.stringify(data));
}

// ====================== 登录/权限校验 ======================
// 登录
function login(role, account, pwd) {
    const data = getSystemData();
    // 教师登录
    if(role === 'teacher') {
        if(data.teacher.account === account && data.teacher.pwd === pwd) {
            sessionStorage.setItem('current-user', JSON.stringify({ role, account, name: data.teacher.name }));
            return { success: true };
        }
    }
    // 学生登录
    else if(role === 'student') {
        const stu = data.students.find(s => s.account === account && s.pwd === pwd);
        if(stu) {
            sessionStorage.setItem('current-user', JSON.stringify({ role, account, name: stu.name, id: stu.id }));
            return { success: true };
        }
    }
    return { success: false, message: "账号或密码错误" };
}

// 校验登录状态
function checkLogin(requiredRole) {
    const currentUser = sessionStorage.getItem('current-user');
    if(!currentUser) return false;
    const user = JSON.parse(currentUser);
    return requiredRole ? user.role === requiredRole : true;
}

// 退出登录
function logout() {
    sessionStorage.removeItem('current-user');
    window.location.href = 'index.html';
}

// 获取当前登录用户
function getCurrentUser() {
    const user = sessionStorage.getItem('current-user');
    return user ? JSON.parse(user) : null;
}

// ====================== 通用工具 ======================
// 单词发音
function playWordVoice(word) {
    const utterance = new SpeechSynthesisUtterance(word);
    utterance.lang = 'en-US';
    window.speechSynthesis.speak(utterance);
}

