<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<title>数学作业提交</title>
<style>*{margin:0;padding:0;box-sizing:border-box;font-family:微软雅黑}body{background:#e3f2fd;padding:30px}.back{padding:10px 20px;background:#0288d1;color:#fff;border-radius:30px;cursor:pointer;margin-bottom:20px}.container{max-width:700px;margin:0 auto;background:#fff;padding:30px;border-radius:16px}h2{text-align:center;color:#0d47a1;margin-bottom:20px}.item{margin-bottom:15px}label{display:block;margin-bottom:5px;font-weight:bold}input,textarea,select{width:100%;padding:10px;border:1px solid #ccc;border-radius:8px}button{width:100%;padding:12px;background:#0288d1;color:#fff;border:none;border-radius:8px;margin-top:10px;cursor:pointer}</style>
</head>
<body>
<div class="back" onclick="location.href='index.html'">← 返回主页</div>
<div class="container">
<h2>数学作业提交系统</h2>
<div class="item"><label>学生姓名</label><input type="text"></div>
<div class="item"><label>班级</label><select><option>一年级</option><option>二年级</option></select></div>
<div class="item"><label>作业内容</label><textarea rows="5"></textarea></div>
<div class="item"><label>上传图片</label><input type="file"></div>
<button>提交作业</button>
</div>
</body>
</html>
